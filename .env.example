# MAAIRA FASHION BAGS — environment variables (names and descriptions only; never commit real values)

# Public site URL used for canonical/OG metadata, e.g. https://www.example.com
NEXT_PUBLIC_SITE_URL=

# Set to "true" only after client approval of real product data and pricing.
# While unset/false, every page is served with noindex,nofollow because the
# sample showcase uses placeholder prices (₹XXXX).
NEXT_PUBLIC_ALLOW_INDEXING=false
