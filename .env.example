# MAAIRA FASHION BAGS — environment variables
# Names and descriptions only. Never commit real values (.env* is gitignored).

# ---------------------------------------------------------------- Site
# Public origin used for canonical/OG metadata, e.g. https://maaira.co.in
NEXT_PUBLIC_SITE_URL=
# Set to "true" only after the client approves real product data and prices.
# While unset/false every page is served noindex,nofollow (prices are ₹XXXX).
NEXT_PUBLIC_ALLOW_INDEXING=false

# ---------------------------------------------------------------- Enquiries & callbacks
# Where submissions are stored. One of:
#   supabase  → Supabase table `enquiries` (apply supabase/migrations/0001_enquiries.sql)
#   file      → JSON lines on the server's disk (single Node server only; NOT durable on serverless)
#   (unset)   → auto: supabase when both keys below are set, otherwise no store
ENQUIRY_STORE=
# File store location (when ENQUIRY_STORE=file).
ENQUIRY_FILE_PATH=.data/enquiries.jsonl
# Supabase project URL and service-role key — SERVER ONLY, never exposed to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Optional: max submissions per IP per 10 minutes (default 5).
ENQUIRY_RATE_LIMIT_MAX=

# Optional email notification for each new request (Resend, https://resend.com).
# All three are required to enable it; the sender domain must be verified.
RESEND_API_KEY=
ENQUIRY_NOTIFY_TO=
ENQUIRY_NOTIFY_FROM=

# With neither a store nor email configured, /api/enquiries answers 503
# "not configured" and the form honestly offers email/phone instead.

# ---------------------------------------------------------------- Admin (enquiry review)
# HTTP Basic credentials for /admin/enquiries. The admin area returns 404
# unless both are set. Use a long random password (12+ characters, required).
ADMIN_USER=
ADMIN_PASSWORD=
