# MAAIRA FASHION BAGS — environment variables
# Names and descriptions only. Never commit real values (.env* is git-ignored
# except this file). Use separate values for development, staging and production.

# ───────────────────────────────────────────────────────────── Site (required)
# Public origin, used for canonical URLs, sitemap and as the trusted origin.
NEXT_PUBLIC_SITE_URL=
# "true" only after the client approves real product data and prices.
# Until then every page is noindex and robots.txt disallows crawling.
NEXT_PUBLIC_ALLOW_INDEXING=false

# ───────────────────────────────────────────────────────────── Database (required)
# PostgreSQL 14+ connection string (Supabase, Neon, RDS, or self-hosted).
# On serverless hosts use the provider's pooled connection string.
DATABASE_URL=
# Optional: max connections per server instance (default 10).
DATABASE_POOL_MAX=
# Tests only — a SEPARATE database; tests truncate it. Never point at production.
TEST_DATABASE_URL=

# ───────────────────────────────────────────────────────────── Accounts (required)
# 32+ random characters (e.g. `openssl rand -base64 48`). Rotating it signs everyone out.
BETTER_AUTH_SECRET=
# Optional: auth base URL if different from NEXT_PUBLIC_SITE_URL.
BETTER_AUTH_URL=

# ───────────────────────────────────────────────────────────── Payments (required for checkout)
# Razorpay keys from Dashboard → Settings → API Keys. Use rzp_test_ keys until
# the client authorises live payments. Checkout stays closed while unset.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
# Webhook secret (Dashboard → Webhooks) for https://<site>/api/webhooks/razorpay
# with events payment.captured, payment.failed, order.paid.
RAZORPAY_WEBHOOK_SECRET=

# ───────────────────────────────────────────────────────────── Email (optional)
# Resend (https://resend.com). Needed for order confirmations, enquiry
# notifications and password-reset emails. The sender domain must be verified.
RESEND_API_KEY=
EMAIL_FROM=
# Comma-separated business inbox(es) for new enquiries and paid orders.
BUSINESS_NOTIFY_TO=

# ───────────────────────────────────────────────────────────── Operations
# Bearer secret for the scheduled job GET /api/cron/expire-orders
# (cancels unpaid orders after 30 minutes and releases stock).
CRON_SECRET=
# Optional: enquiries per IP per 10 minutes (default 5).
ENQUIRY_RATE_LIMIT_MAX=
